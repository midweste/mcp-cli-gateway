# ── Gateway Configuration ──
# All values have sensible defaults. Set only what you need to override.
# Priority: CLI flag > env var > default.

# ── Database ──
# SQLite database path (default: data/mcp-cli-gateway.sqlite)
# GATEWAY_DB_PATH=data/mcp-cli-gateway.sqlite

# ── Provider Selection ──
# Enable/disable CLI providers (true|false, unset = auto-detect via PATH)
# GATEWAY_PROVIDER_GEMINI=true
# GATEWAY_PROVIDER_CODEX=true
# GATEWAY_PROVIDER_CLAUDE=true

# Provider ordering: which provider gets requests first within each tier.
# Comma-separated list of provider names. First = preferred.
# When two providers have equal load, the earlier one gets the job.
# Unset = alphabetical order (claude, codex, gemini).
# GATEWAY_PROVIDER_ORDER=gemini,codex,claude

# ── Timeout & Retries ──
# GATEWAY_TIMEOUT_SECONDS=420
# GATEWAY_MAX_RETRIES=3
# GATEWAY_CLEANUP_DAYS=7

# ── Pacing / Rate-Limit Tuning ──
# GATEWAY_CEILING_MS=10000
# GATEWAY_BACKOFF_INITIAL_MS=1500
# GATEWAY_BACKOFF_MAX_MS=8000
# GATEWAY_SPEEDUP_FACTOR=0.90
# GATEWAY_SLOWDOWN_FACTOR=1.3
# GATEWAY_STREAK_THRESHOLD=3
# GATEWAY_STREAK_SPEEDUP=0.85
# GATEWAY_QUEUE_POLL_SECONDS=3

# ── System Prompt ──
# Prefix injected into every dispatched agent's system prompt.
# GATEWAY_SYSTEM_PREFIX="You are a code generation subagent..."

# ── Project Root ──
# Lock all dispatched agents to this directory. Set automatically at startup.
# PROJECT_ROOT=/path/to/project
